# Copy this file to .env and fill in YOUR values. Never commit .env.
#   Windows:  copy .env.example .env      macOS/Linux:  cp .env.example .env

# Which settings in config.py to use: development, testing or production
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# MySQL: local Workbench (127.0.0.1:3306) or Aiven (Service -> Overview -> Connection information)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=paste-your-password-here
DB_NAME=taphouse_didss

# Only needed for Aiven with certificate checking: path to the downloaded CA file
# DB_SSL_CA=ca.pem

# Separate database the API tests can wipe and rebuild (tests/test_api.py)
TEST_DB_NAME=taphouse_didss_test

# Supply chain model target service level (proposal: at least 0.95)
SERVICE_LEVEL=0.95

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
